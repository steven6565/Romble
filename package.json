{
  "name": "youtube-rumble-termux",
  "version": "4.0.0",
  "description": "YouTube & Rumble platform dashboard for Android — runs natively in Termux",
  "private": true,
  "scripts": {
    "start": "bash start.sh",
    "stop": "bash stop.sh",
    "restart": "bash scripts/restart.sh",
    "status": "bash scripts/status.sh",
    "install": "bash install.sh",
    "update": "bash update.sh",
    "test": "node tests/smoke.test.js",
    "backend:dev": "node backend/server.js",
    "frontend:build": "cd frontend && npm run build",
    "frontend:dev": "cd frontend && npm run dev"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["youtube", "rumble", "termux", "android", "dashboard"],
  "license": "MIT"
}
