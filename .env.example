# Environment configuration for the YouTube & Rumble Termux dashboard.
# Copy this file to .env and edit values. Sensitive keys must never be
# committed — .env is gitignored.

# --- Server -----------------------------------------------------------
# Port the dashboard listens on (localhost only by default).
PORT=3000
# Bind address. 127.0.0.1 = localhost only (recommended).
HOST=127.0.0.1
# Set to 1 to bind on all interfaces (not recommended on a phone).
PUBLIC_BIND=0

# --- Database ---------------------------------------------------------
# Files live in ./database (JSON documents, human readable).
DB_DIR=database

# --- Logging ----------------------------------------------------------
# ./logs holds backend.log and the dashboard terminal log.
LOG_DIR=logs
# How many days of activity history to keep.
LOG_RETENTION_DAYS=7

# --- Platforms --------------------------------------------------------
# YouTube Data API v3 key (https://console.cloud.google.com).
YOUTUBE_API_KEY=""
# Rumble is scraped officially via yt-dlp (`pkg install yt-dlp` on Termux).
# Alternative public Invidious instance for metadata when yt-dlp is absent.
INVIDIOUS_INSTANCE=https://yewtu.be

# --- Tasks (organic viewer growth) ------------------------------------
# Global max concurrent organic requests (keep low on a phone).
TASK_MAX_CONCURRENCY=3
# Seconds between organic requests (randomised around this value).
TASK_REQUEST_INTERVAL=5
# Approximate average seconds per view on YouTube/Rumble.
TASK_AVERAGE_DURATION=120
# Max total requests a task runs for; 0 = unlimited while running.
TASK_MAX_REQUESTS=0

# --- Timeouts / rate limits -------------------------------------------
# Seconds before a platform API request times out.
API_TIMEOUT_SECONDS=10
# Local dashboard auto-refresh interval in seconds.
STATS_REFRESH_SECONDS=3
